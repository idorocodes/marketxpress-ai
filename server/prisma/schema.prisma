
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  VENDOR
}

enum DealStatus {
  AWAITING_VENDOR_CONFIRMATION
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  
  // Relations
  products     Product[]     // If they are a VENDOR
  chats        ChatMessage[]
  dealsAsBuyer Deal[]        @relation("BuyerDeals")
}

model Product {
  id         String   @id @default(uuid())
  name       String   // e.g., "rice", "tomatoes"
  advertised Float    // Original retail price (e.g., 750)
  minimum    Float    // Floor price vendor will accept (e.g., 700)
  stock      Int
  vendorId   String
  vendor     User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  message   String
  sender    String   // "user" or "system"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Deal {
  id         String     @id @default(uuid())
  buyerId    String
  buyer      User       @relation("BuyerDeals", fields: [buyerId], references: [id])
  vendorId   String     // ID of the matched vendor
  items      Json       // Array of items negotiated: [{name: "rice", qty: 3, negotiatedPrice: 685}]
  totalPrice Float      // e.g., 3115
  status     DealStatus @default(AWAITING_VENDOR_CONFIRMATION)
  qrCodeText String?    // Generated string to turn into a canvas QR component
  createdAt  DateTime   @default(now())
}